MODEL_PATH=models/clinvision_pneumonia.keras
MODEL_VERSION=clinvision-v2
API_URL=http://localhost:8000
MAX_UPLOAD_MB=20
LOG_LEVEL=INFO

# --- Doctor login (frontend gate + backend /auth/login) ---
DOCTOR_USERNAME=doctor
DOCTOR_PASSWORD=doctor123
# Set to true to force a bearer token on /predict /analyze etc.
REQUIRE_AUTH=false
AUTH_TOKEN_TTL_HOURS=12

# --- FREE LLM (tried in order; all optional, template fallback otherwise) ---
# 1) Ollama local — 100% free, no key. Install: brew install ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# 2) Groq free tier (console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# 3) Gemini free tier (aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# 4) Hugging Face free serverless (huggingface.co)
HF_API_KEY=
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3
# 5) Generic OpenAI-compatible endpoint (legacy)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
